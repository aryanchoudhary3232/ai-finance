# ==============================================================================
# AI Finance Platform - Environment Variables Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Next.js Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Prisma ORM)
# ------------------------------------------------------------------------------
# For pooled connections (e.g., Supabase / PgBouncer or local PostgreSQL)
DATABASE_URL="postgresql://finance_user:finance_password@localhost:5432/ai_finance?schema=public&pgbouncer=true"

# Direct URL for Prisma migrations
DIRECT_URL="postgresql://finance_user:finance_password@localhost:5432/ai_finance?schema=public"

# Optional: Local Docker PostgreSQL container credentials (if using docker-compose)
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_DB=ai_finance

# ------------------------------------------------------------------------------
# 2. Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 3. Google Gemini API (AI Receipt Scanning)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Resend (Email Notifications & Transaction Alerts)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 5. ArcJet (Bot Protection & Rate Limiting)
# ------------------------------------------------------------------------------
ARCJET_KEY=ajkey_your_arcjet_api_key_here

# ------------------------------------------------------------------------------
# 6. Inngest (Background Jobs & Scheduled Financial Workflows)
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here
